config BR2_PACKAGE_AUSWEISAPP
    bool "ausweisapp"
    depends on BR2_INSTALL_LIBSTDCPP
    select BR2_PACKAGE_QT6
    select BR2_PACKAGE_QT6BASE
    select BR2_PACKAGE_QT6BASE_CONCURRENT
    select BR2_PACKAGE_QT6DECLARATIVE_QUICK
    select BR2_PACKAGE_QT6SCXML
    select BR2_PACKAGE_QT6LANGUAGESERVER
    select BR2_PACKAGE_QT6WEBSOCKETS
    select BR2_PACKAGE_QT6DECLARATIVE
    select BR2_PACKAGE_QT6BASE_FONTCONFIG
    select BR2_PACKAGE_QT6BASE_GUI
    select BR2_PACKAGE_QT6BASE_WIDGETS
    select BR2_PACKAGE_FONT_AWESOME
    select BR2_PACKAGE_QT6SVG
    select BR2_PACKAGE_QT6CONNECTIVITY
    select BR2_PACKAGE_NEARD
    select BR2_PACKAGE_OPENSSL
    select BR2_PACKAGE_OPENSC
    select BR2_PACKAGE_HOST_QT6TOOLS
    select BR2_PACKAGE_HOST_QT6TOOLS_LINGUIST_TOOLS
    select BR2_PACKAGE_HOST_QT6SHADERTOOLS
    help
      ausweisapp

comment "ausweisapp needs a toolchain w/ C++"
    depends on !BR2_INSTALL_LIBSTDCPP
